.DS_store

# Dependency directories
node_modules/

# Fractal build directory
build/

# Federalist build directory
_site/

# Webpack default dist folder
dist/

# Ignore USWDS fonts only
/src/fonts/*

# Ignore USWDS images only
/src/img/*
!/src/img/sam

# ignore saved screenshots
spec/screenshots/*.png
spec/screenshots/metadata.js

# ignore VSCode files
.vscode/

# coverage output (component-coverage.json is committed — see #822)
coverage/*
!coverage/component-coverage.json

# Playwright test output
test-results/
playwright-report/

# Generated stylelint report (regenerated by lint:report; only
# stylelint-baseline.json is committed)
stylelint-report.json
